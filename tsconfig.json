{
  "compilerOptions": {
    "incremental": true,
    "target": "ES2023",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "baseUrl": "./",
    "ignoreDeprecations": "6.0",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "paths": {
      "@nest-app/common": [
        "libs/common/src"
      ],
      "@nest-app/common/*": [
        "libs/common/src/*"
      ],
      "@nest-app/framework": [
        "libs/framework/src"
      ],
      "@nest-app/framework/*": [
        "libs/framework/src/*"
      ],
      "@nest-app/config": [
        "libs/config/src"
      ],
      "@nest-app/config/*": [
        "libs/config/src/*"
      ],
      "@nest-app/prisma": [
        "libs/prisma/src"
      ],
      "@nest-app/prisma/*": [
        "libs/prisma/src/*"
      ],
      "@nest-app/utils": [
        "libs/utils/src"
      ],
      "@nest-app/utils/*": [
        "libs/utils/src/*"
      ],
      "@orm/*": [
        "prisma/*"
      ]
    },
    "resolvePackageJsonExports": true,
    "types": [
      "node"
    ],
    "strictBindCallApply": false,
    "strictNullChecks": true,
    "noFallthroughCasesInSwitch": false,
    "noImplicitAny": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "declaration": true,
    "outDir": "./dist",
    "removeComments": true,
    "sourceMap": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": [
    "types/**/*.ts",
    "apps/**/*.ts",
    "libs/**/*.ts",
    "prisma.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}