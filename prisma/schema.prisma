generator client {
  provider     = "prisma-client"
  output       = "./generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

/// List 表
model List {
  /// 自增主键
  id         Int       @id @default(autoincrement())
  /// 邮箱（唯一）
  email      String    @unique
  /// 昵称，可选
  name       String?
  /// 状态（用枚举约束）
  status     Status    @default(ACTIVE)
  /// 标签数组（Prisma 在 PostgreSQL 原生支持数组，MySQL 可以用 JSON 存储）
  tags       Json?
  /// 扩展信息（用 JSON 存储任意结构）
  metadata   Json?
  /// 积分（默认 0）
  score      Int       @default(0)
  /// 余额
  balance    String?
  /// 性别（用枚举）
  gender     Gender?
  /// 手机号，唯一，并加索引
  phone      String?   @unique @db.VarChar(20)
  /// 创建时间 默认当前时间
  createTime DateTime  @default(now()) @db.DateTime(0)
  /// 更新时间（由 Prisma 自动管理）
  updateTime DateTime? @updatedAt @db.DateTime(0)
  /// 软删除标记
  deleted    Boolean   @default(false)

  @@index([email, phone])
  @@map("list")
}

/// 文件资产表 - 存储上传到 RustFS 对象存储的文件元数据
model FileAsset {
  /// 文件唯一标识符（CUID 格式）
  id           String    @id @default(cuid())
  /// 存储桶名称（如 nest-app）
  bucket       String    @db.VarChar(63)
  /// 对象存储路径（如 files/2026-09-07/image/xxx.jpg）
  objectKey    String    @unique @db.VarChar(512)
  /// 用户上传时的原始文件名
  originalName String    @db.VarChar(255)
  /// 文件 MIME 类型（如 image/jpeg）
  mimeType     String    @db.VarChar(255)
  /// 文件分类（image/video/document/audio 等）
  category     String    @db.VarChar(32)
  /// 文件大小（字节数）
  size         BigInt
  /// 对象存储返回的 ETag 标识，用于验证完整性
  etag         String?   @db.VarChar(255)
  /// 文件上传时间
  createTime   DateTime  @default(now()) @db.DateTime(0)
  /// 软删除时间（null 表示未删除）
  deleteTime   DateTime? @db.DateTime(0)

  @@index([bucket, createTime])
  @@index([deleteTime])
  @@map("file_asset")
}

/// 操作日志表
model OperationLog {
  /// 日志唯一标识符
  id             String   @id @default(cuid())
  /// 请求发生时间
  operateTime    DateTime @default(now()) @db.DateTime(0)
  /// 请求耗时（毫秒）
  duration       Int
  /// 客户端 IP 地址
  ip             String?  @db.VarChar(64)
  /// 请求方法
  requestMethod  String   @db.VarChar(16)
  /// 请求地址
  requestUrl     String   @db.VarChar(512)
  /// 请求参数（请求体、查询参数和路径参数）
  requestParams  Json?
  /// 响应状态码
  responseStatus Int?
  /// 响应参数
  responseParams Json?
  /// 未来 RBAC 兼容：用户标识
  userId         String?  @db.VarChar(64)
  /// 未来 RBAC 兼容：用户名
  username       String?  @db.VarChar(128)
  /// 未来 RBAC 兼容：部门标识
  departmentId   String?  @db.VarChar(64)
  /// 未来 RBAC 兼容：部门名称
  departmentName String?  @db.VarChar(128)
  /// 所属模块
  module         String?  @db.VarChar(128)
  /// 操作名称
  operation      String?  @db.VarChar(128)
  /// 异常信息
  errorMessage   String?  @db.Text

  @@index([operateTime])
  @@index([module, operateTime])
  @@index([userId, operateTime])
  @@map("operation_log")
}

/// 状态枚举
enum Status {
  ACTIVE
  INACTIVE
  BANNED
}

/// 性别枚举
enum Gender {
  MALE
  FEMALE
  OTHER
}
