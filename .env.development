# app
APP_NAME = NESTDOME                # 程序名称
API_PREFIX = /dev                  # api 前缀
APP_PORT = 6688                    # 程序端口
APP_RES_MODE = complex             # 返回数据响应格式 simple | complex

# logger
LOGGER_LEVEL = debug               # 日志等级
LOGGER_DIR = logs                  # 日志目录
LOGGER_CONSOLE = false             # 是否输出到控制台

# file
UPLOAD_MAX_FILE_SIZE = 10          # 单个文件最大大小（MB）
UPLOAD_MAX_FIELDS = 5              # 最大非文件字段数量
UPLOAD_MAX_FILES = 5               # 单次请求最大文件数量

# RustFS object storage
RUSTFS_ENDPOINT = http://127.0.0.1:9000
RUSTFS_REGION = us-east-1
RUSTFS_ACCESS_KEY = admin
RUSTFS_SECRET_KEY = admin123
RUSTFS_BUCKET = nest-app
RUSTFS_FORCE_PATH_STYLE = true

# swagger
SWAGGER_ENABLE = true              # 是否启用 swagger
SWAGGER_PATH = api-docs            # swagger 文档路径
SWAGGER_VERSION = 1.0              # swagger 文档版本


# 有关更多细节，请参阅文档: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# db
DB_HOST = 127.0.0.1                # 数据库地址
DB_PORT = 3306                     # 数据库端口
DB_DATABASE = nest_admin           # 数据库名称
DB_USERNAME = root                 # 数据库用户名
DB_PASSWORD = 123456               # 数据库密码
DB_CONNECTION_LIMIT = 5            # 数据库连接池大小

# Redis
REDIS_ENABLED = true                # 是否启用 Redis
REDIS_HOST = 127.0.0.1              # Redis 地址
REDIS_PORT = 6379                   # Redis 端口
REDIS_USERNAME =                    # Redis 用户名（可选）
REDIS_PASSWORD =                    # Redis 密码（可选）
REDIS_DATABASE = 0                  # Redis 数据库编号
REDIS_KEY_PREFIX = nest-app:        # Key 前缀
REDIS_CONNECT_TIMEOUT = 1000        # 连接超时（毫秒）
